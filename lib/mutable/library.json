{
  "name": "mutable",
  "version": "1.2.0",
  "description": "Mutable Instruments Plaits 1.2 DSP and stmlib by Emilie Gillet (MIT licence), vendored with small portability patches for non-ARM targets. Unofficial port, not affiliated with Mutable Instruments.",
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "flags": [
      "-O2",
      "-fsingle-precision-constant",
      "-Wno-unused-variable",
      "-Wno-unused-local-typedefs",
      "-Wno-unused-but-set-variable"
    ],
    "unflags": "-Os"
  },
  "authors": [
    {
      "name": "Emilie Gillet",
      "email": "emilie.o.gillet@gmail.com",
      "url": "https://mutable-instruments.net",
      "maintainer": false
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pichenettes/eurorack"
  },
  "homepage": "https://pichenettes.github.io/mutable-instruments-documentation/modules/plaits/"
}
